{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/sebt-portal-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext"]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "EnrollmentCheckRateLimitSettings": {
    "PermitLimit": 10,
    "WindowMinutes": 1.0
  },
  "WebhookRateLimitSettings": {
    "PermitLimit": 60,
    "WindowMinutes": 1.0
  },
  "JwtSettings": {
    "Issuer": "SEBT.Portal.Api",
    "Audience": "SEBT.Portal.Web",
    "ExpirationMinutes": 60
  },
  "IdProofingRequirements": {
    "address+view": "IAL1plus",
    "email+view": "IAL1",
    "phone+view": "IAL1"
  },
  "SelfServiceRules": {
    "AddressUpdate": {
      "Enabled": true,
      "DisabledMessageKey": "actionNavigationSelfServiceUnavailable",
      "ByIssuanceType": {
        "SummerEbt": { "Enabled": true, "AllowedCardStatuses": [] },
        "TanfEbtCard": { "Enabled": false },
        "SnapEbtCard": { "Enabled": false },
        "Unknown": { "Enabled": false }
      }
    },
    "CardReplacement": {
      "Enabled": true,
      "DisabledMessageKey": "actionNavigationSelfServiceUnavailable",
      "ByIssuanceType": {
        "SummerEbt": { "Enabled": true, "AllowedCardStatuses": [] },
        "TanfEbtCard": { "Enabled": false },
        "SnapEbtCard": { "Enabled": false },
        "Unknown": { "Enabled": false }
      }
    }
  },
  "Smarty": {
    "Enabled": false,
    "BaseUrl": "https://us-street.api.smartystreets.com",
    "TimeoutSeconds": 20
  },
  "AddressValidationPolicy": {
    "AllowGeneralDelivery": false
  },
  "AddressValidationData": {
    "BlockedAddresses": [],
    "StreetAbbreviations": {},
    "MaxStreetAddressLength": 0
  },
  "FeatureManagement": {
    "email_dob_opt_in": false,
    "show_application_number": true,
    "show_case_number": true,
    "show_card_last4": true,
    "enable_beta_banner": false,
    "AppConfig": {
      "Enabled": false,
      "ApplicationId": "",
      "EnvironmentId": "",
      "ConfigurationProfileId": ""
    },
    "bypass_otp": false
  }
}
