<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SEBT.Portal.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <HomeDir Condition="'$(OS)' == 'Windows_NT'">$(USERPROFILE)</HomeDir>
    <HomeDir Condition="'$(HomeDir)' == ''">$(HOME)</HomeDir>
    <RestoreAdditionalProjectSources>$(HomeDir)/nuget-store</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
      <ProjectReference Include="../SEBT.Portal.Kernel/SEBT.Portal.Kernel.csproj" />
      <ProjectReference Include="..\SEBT.Portal.Core\SEBT.Portal.Core.csproj" />
      <ProjectReference Include="..\SEBT.Portal.Infrastructure.Seeding\SEBT.Portal.Infrastructure.Seeding.csproj" />
      <ProjectReference Include="..\SEBT.Portal.TestUtilities\SEBT.Portal.TestUtilities.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="MailKit" Version="4.14.1" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.0" />
      <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.0" />
      <PackageReference Include="Bogus" Version="35.6.5" />
      <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
      <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
      <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
      <PackageReference Include="Microsoft.FeatureManagement" Version="3.3.0" />
      <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.2.1" />
    </ItemGroup>

  <!-- Prefer state connector interfaces project when sibling repo exists; otherwise use NuGet package -->
  <Choose>
    <When Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\sebt-self-service-portal-state-connector\src\SEBT.Portal.StatesPlugins.Interfaces\SEBT.Portal.StatesPlugins.Interfaces.csproj')">
      <ItemGroup>
        <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\..\sebt-self-service-portal-state-connector\src\SEBT.Portal.StatesPlugins.Interfaces\SEBT.Portal.StatesPlugins.Interfaces.csproj">
          <Aliases>statePlugin</Aliases>
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </ProjectReference>
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <PackageReference Include="SEBT.Portal.StatesPlugins.Interfaces" Version="0.0.1-*" Alias="statePlugin" PrivateAssets="compile" />
      </ItemGroup>
    </Otherwise>
  </Choose>

    <ItemGroup>
      <EmbeddedResource Include="Templates\Email\OtpEmail.html" />
      <EmbeddedResource Include="Templates\Email\logo.png" />
    </ItemGroup>

    <Target Name="ApplyStatePluginAlias" BeforeTargets="FindReferenceAssembliesForReferences;CoreCompile">
      <ItemGroup>
        <ReferencePath Condition="'%(Filename)' == 'SEBT.Portal.StatesPlugins.Interfaces'">
          <Aliases>statePlugin</Aliases>
        </ReferencePath>
      </ItemGroup>
    </Target>

</Project>
