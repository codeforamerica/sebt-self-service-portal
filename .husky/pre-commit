#!/bin/sh
# Pre-commit hook: Runs linting, build validation, and test validation
# 

set -e  # Exit on error

log_info() {
  echo "ℹ️  $1"
}

log_success() {
  echo "✅ $1"
}

log_error() {
  echo "❌ $1"
}

PROJECT_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$PROJECT_ROOT"

# Check if there are backend changes in staged files (portal, in-repo connectors,
# or the shared build configuration they all inherit).
has_backend_changes() {
  git diff --cached --name-only | grep -vE '^apps/portal/src/SEBT\.Portal\.Web' | grep -qE '^apps/portal/src/SEBT\.Portal\.|^apps/portal/test/|^apps/connectors/|^(Directory\.Build\.props|global\.json|nuget\.config)$|\.(csproj|sln|slnx)$' || return 1
}

# Check if there are frontend changes in staged files
has_frontend_changes() {
  git diff --cached --name-only | grep -qE '^apps/portal/src/SEBT\.Portal\.Web/' || return 1
}

staged_dockerfiles() {
  git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)(Dockerfile(\.[^/]*)?|[^/]*\.[Dd]ockerfile)$' || true
}

# Check if cooldown-exclusion sources were staged (workspace policy or lockfile)
has_cooldown_exclusion_changes() {
  git diff --cached --name-only | grep -qE '^(pnpm-workspace\.yaml|pnpm-lock\.yaml)$' || return 1
}

log_info "=== Running pre-commit checks ==="
echo ""

# Determine what needs to run
BACKEND_CHANGES=false
FRONTEND_CHANGES=false

if has_backend_changes; then
  BACKEND_CHANGES=true
fi

if has_frontend_changes; then
  FRONTEND_CHANGES=true
fi

# Calculate step numbers
STEP_NUM=0
TOTAL_STEPS=0

COOLDOWN_CHANGES=false
if has_cooldown_exclusion_changes; then
  COOLDOWN_CHANGES=true
  TOTAL_STEPS=$((TOTAL_STEPS + 1))  # cooldown exclusion staleness check
fi

STAGED_DOCKERFILES=$(staged_dockerfiles)
if [ -n "$STAGED_DOCKERFILES" ]; then
  TOTAL_STEPS=$((TOTAL_STEPS + 1))  # hadolint
fi

if [ "$FRONTEND_CHANGES" = "true" ]; then
  TOTAL_STEPS=$((TOTAL_STEPS + 3))  # lint-staged + build + tests
fi

if [ "$BACKEND_CHANGES" = "true" ]; then
  TOTAL_STEPS=$((TOTAL_STEPS + 3))  # format + build + tests
fi

# Step 1: Cooldown exclusion staleness check (if workspace policy or lockfile staged)
if [ "$COOLDOWN_CHANGES" = "true" ]; then
  STEP_NUM=$((STEP_NUM + 1))
  log_info "Step $STEP_NUM/$TOTAL_STEPS: Checking pnpm cooldown exclusions for staleness..."
  cd "$PROJECT_ROOT"
  pnpm --silent check:cooldown-exclusions || {
    log_error "Stale minimumReleaseAgeExclude entries detected — remove them before committing"
    exit 1
  }
  log_success "Cooldown exclusions are current"
  echo ""
fi

# Step 2: Dockerfile linting (if Dockerfiles staged)
if [ -n "$STAGED_DOCKERFILES" ]; then
  STEP_NUM=$((STEP_NUM + 1))
  log_info "Step $STEP_NUM/$TOTAL_STEPS: Linting staged Dockerfiles with hadolint..."
  cd "$PROJECT_ROOT"

  # First runtime that is installed and running; either CLI runs the same command.
  CONTAINER_CLI=""
  for runtime in docker podman; do
    if command -v "$runtime" > /dev/null 2>&1 && "$runtime" info > /dev/null 2>&1; then
      CONTAINER_CLI="$runtime"
      break
    fi
  done

  if [ -z "$CONTAINER_CLI" ]; then
    log_error "No running container runtime found - hadolint runs in a container. Install and start Docker or Podman (e.g. 'podman machine start'): https://podman.io/docs/installation"
    exit 1
  fi

  # Pinned so every developer lints against the same rule set. hadolint v2.15.1.
  # Fully qualified so Podman doesn't need short-name resolution.
  HADOLINT_IMAGE="docker.io/hadolint/hadolint@sha256:32dac94127fd60b7b7e3fbfc65e1383b9b5e25c9bfd7b8536de7a539fe68a12d"

  # shellcheck disable=SC2086 # word-split the newline-separated file list into arguments
  "$CONTAINER_CLI" run --rm -v "$PROJECT_ROOT:/repo:ro" -w /repo "$HADOLINT_IMAGE" hadolint $STAGED_DOCKERFILES || {
    log_error "Dockerfile linting failed - fix the issues above, or suppress a rule with an inline '# hadolint ignore=DLxxxx' comment"
    exit 1
  }
  log_success "Dockerfile linting passed"
  echo ""
fi

# Step 3: Frontend linting (if frontend changes)
if [ "$FRONTEND_CHANGES" = "true" ]; then
  STEP_NUM=$((STEP_NUM + 1))
  log_info "Step $STEP_NUM/$TOTAL_STEPS: Running linters and auto-fixing staged files..."

  if ! command -v node &> /dev/null; then
    log_error "Node.js not found - Please install via `brew install node` or from https://nodejs.org/"
    exit 1
  fi

  if ! command -v pnpm &> /dev/null; then
    log_error "pnpm not found - Please install via `npm install -g pnpm` or `brew install pnpm`"
    exit 1
  fi

  cd apps/portal/src/SEBT.Portal.Web || {
    log_error "Could not change to web package directory"
    exit 1
  }

  pnpm exec lint-staged || {
    log_error "Linting failed"
    exit 1
  }
  log_success "Linting passed"
  echo ""
  cd "$PROJECT_ROOT"
fi

# Step 4: Backend formatting (if backend changes)
if [ "$BACKEND_CHANGES" = "true" ]; then
  STEP_NUM=$((STEP_NUM + 1))
  log_info "Step $STEP_NUM/$TOTAL_STEPS: Running .NET code formatting and analyzer checks..."
  cd "$PROJECT_ROOT"

  if command -v dotnet &> /dev/null; then
    # Verify formatting only for staged .cs files. --include scopes dotnet format to
    # exactly those files, so --exclude for sibling repos isn't needed (staged paths
    # from this repo can never resolve to ../sibling-repo/).
    STAGED_CS_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.cs$' || true)

    if [ -n "$STAGED_CS_FILES" ]; then
      INCLUDE_FLAGS=""
      for f in $STAGED_CS_FILES; do
        INCLUDE_FLAGS="$INCLUDE_FLAGS --include $f"
      done

      dotnet format SEBT.slnx whitespace --verify-no-changes --verbosity quiet $INCLUDE_FLAGS || {
        log_error ".NET code formatting check failed - run 'pnpm api:format:staged' to fix"
        exit 1
      }

      dotnet format SEBT.slnx analyzers --verify-no-changes --verbosity quiet $INCLUDE_FLAGS || {
        log_error ".NET analyzer checks failed - fix the reported issues"
        exit 1
      }
    fi
    
    log_success ".NET linting passed"
  else
    log_error ".NET SDK not found - Please install via `brew install dotnet` or via the Windows Installer (if using Windows). Aborting .NET linting."
    exit 1
  fi
  echo ""
fi

# Step 5: Backend build (if backend changes)
if [ "$BACKEND_CHANGES" = "true" ]; then
  STEP_NUM=$((STEP_NUM + 1))
  log_info "Step $STEP_NUM/$TOTAL_STEPS: Validating backend build..."
  cd "$PROJECT_ROOT"

  if command -v dotnet &> /dev/null; then
    dotnet restore SEBT.slnx --verbosity quiet || {
      log_error "Backend dependency restore failed"
      exit 1
    }
    dotnet build SEBT.slnx --configuration Debug --no-restore --verbosity quiet || {
      log_error "Backend build failed"
      exit 1
    }
    log_success "Backend build validation passed"
  else
    log_error ".NET SDK not found - Please install via `brew install dotnet` or via the Windows Installer (if using Windows). Aborting backend build validation."
    exit 1
  fi
  echo ""
fi

# Step 6: Frontend build (if frontend changes)
if [ "$FRONTEND_CHANGES" = "true" ]; then
  STEP_NUM=$((STEP_NUM + 1))
  log_info "Step $STEP_NUM/$TOTAL_STEPS: Validating frontend build..."
  cd apps/portal/src/SEBT.Portal.Web || {
    log_error "Could not change to web package directory"
    exit 1
  }

  pnpm build || {
    log_error "Frontend build failed"
    exit 1
  }
  log_success "Frontend build validation passed"
  echo ""
  cd "$PROJECT_ROOT"
fi

# Step 7: Backend tests (if backend changes)
if [ "$BACKEND_CHANGES" = "true" ]; then
  STEP_NUM=$((STEP_NUM + 1))
  log_info "Step $STEP_NUM/$TOTAL_STEPS: Running backend tests..."
  cd "$PROJECT_ROOT"

  if command -v dotnet &> /dev/null; then
    # Exclude SqlServer tests (Testcontainers/SQL Server) from pre-commit.
    # They run in CI but cause stack overflows locally when combined with
    # the rest of the suite due to Docker resource pressure under parallelism.
    dotnet test SEBT.slnx --configuration Debug --verbosity quiet --filter "Category!=SqlServer" || {
      log_error "Backend tests failed"
      exit 1
    }
    log_success "Backend tests passed"
  else
    log_error ".NET SDK not found - Please install via `brew install dotnet` or via the Windows Installer (if using Windows). Aborting backend tests."
    exit 1
  fi
  echo ""
fi

# Step 8: Frontend tests (if frontend changes)
if [ "$FRONTEND_CHANGES" = "true" ]; then
  STEP_NUM=$((STEP_NUM + 1))
  log_info "Step $STEP_NUM/$TOTAL_STEPS: Running frontend tests..."
  cd apps/portal/src/SEBT.Portal.Web || {
    log_error "Could not change to web package directory"
    exit 1
  }

  pnpm exec vitest run || {
    log_error "Frontend tests failed"
    exit 1
  }
  log_success "Frontend tests passed"
  echo ""
  cd "$PROJECT_ROOT"
fi

if [ "$BACKEND_CHANGES" = "false" ] && [ "$FRONTEND_CHANGES" = "false" ] && [ -z "$STAGED_DOCKERFILES" ]; then
  log_info "No staged changes detected. Skipping pre-commit checks."
  exit 0
fi

log_success "=== All pre-commit checks passed! ==="
