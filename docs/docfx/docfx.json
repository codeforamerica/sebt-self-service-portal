{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../..",
          "files": [
            "apps/portal/src/SEBT.Portal.Api/SEBT.Portal.Api.csproj",
            "apps/portal/src/SEBT.Portal.Core/SEBT.Portal.Core.csproj",
            "apps/portal/src/SEBT.Portal.UseCases/SEBT.Portal.UseCases.csproj",
            "apps/portal/src/SEBT.Portal.Infrastructure/SEBT.Portal.Infrastructure.csproj",
            "apps/portal/src/SEBT.Portal.Infrastructure.Seeding/SEBT.Portal.Infrastructure.Seeding.csproj",
            "apps/portal/src/SEBT.Portal.Kernel/SEBT.Portal.Kernel.csproj",
            "apps/portal/src/SEBT.Portal.Kernel.AspNetCore/SEBT.Portal.Kernel.AspNetCore.csproj",
            "apps/connectors/state/src/SEBT.Portal.StatesPlugins.Interfaces/SEBT.Portal.StatesPlugins.Interfaces.csproj",
            "apps/connectors/co/src/SEBT.Portal.StatePlugins.CO/SEBT.Portal.StatePlugins.CO.csproj",
            "apps/connectors/co/src/SEBT.Portal.StatePlugins.CO.CbmsApi/SEBT.Portal.StatePlugins.CO.CbmsApi.csproj"
          ]
        }
      ],
      "dest": "api",
      "filter": "filterConfig.yml",
      "namespaceLayout": "nested",
      "memberLayout": "samePage",
      "allowCompilationErrors": true,
      "properties": {
        "TargetFramework": "net10.0",
        "Configuration": "Debug",
        "BuildFrontend": "false"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**",
          "template/**",
          "README.md",
          "filterConfig.yml",
          "adr/_cards.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "img/**",
          "rest/portal.openapi.json",
          "rest/rapidoc-min.js"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "template/sebt"
    ],
    "globalMetadata": {
      "_appName": "Summer EBT Portal & Enrollment Checker",
      "_appTitle": "Summer EBT Portal & Enrollment Checker",
      "_appFooter": "<div class=\"site-footer\"><div><p class=\"site-footer-links\"><a href=\"https://github.com/codeforamerica/sebt-self-service-portal\">codeforamerica/sebt-self-service-portal</a><a href=\"https://github.com/codeforamerica/sebt-self-service-portal/releases\">Releases</p></div></div>",
      "_appFaviconPath": "img/favicon.svg",
      "_enableSearch": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/codeforamerica/sebt-self-service-portal",
        "branch": "main"
      }
    },
    "postProcessors": [
      "ExtractSearchIndex"
    ],
    "markdownEngineName": "markdig",
    "keepFileLink": false,
    "disableGitFeatures": false,
    "fileMetadata": {
      "_disableBreadcrumb": {
        "index.md": true
      },
      "_disableToc": {
        "adr/index.md": true,
        "rest/index.md": true
      },
      "_disableContribution": {
        "rest/index.md": true
      }
    }
  }
}
