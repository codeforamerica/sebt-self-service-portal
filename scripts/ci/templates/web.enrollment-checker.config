<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for the Enrollment Checker static export.

  Unlike the portal (scripts/ci/templates/web.config), this app is built with
  Next.js `output: 'export'` — it is pure static HTML/CSS/JS with no Node
  process, so there is no httpPlatformHandler here.

  Assumes the export is served from a SITE ROOT. The build bakes asset URLs as
  absolute `/_next/...` paths, so hosting it under a virtual directory requires
  rebuilding with BASE_PATH set — a web.config cannot rescue it.

  Requires the IIS URL Rewrite module (https://www.iis.net/downloads/microsoft/url-rewrite).
-->
<configuration>
  <system.webServer>
    <!-- The export emits `check.html`, `results.html`, … alongside `check/`,
         `results/` directories that hold only RSC payload .txt files. IIS will
         not map /check to check.html on its own, and the same-named directory
         has no default document, so without these rules every route but / is a
         403.14. -->
    <rewrite>
      <rules>
        <!-- /check/ -> /check, but only when a matching .html exists. Checked
             before the rewrite below because appending .html to a URL that
             already ends in a slash never resolves to a file. -->
        <rule name="Trailing slash to canonical route" stopProcessing="true">
          <match url="^(.+)/$" />
          <conditions>
            <add input="{DOCUMENT_ROOT}/{R:1}.html" matchType="IsFile" />
          </conditions>
          <action type="Redirect" url="{R:1}" redirectType="Permanent" />
        </rule>

        <!-- /check -> /check.html. The IsFile negation leaves real assets
             (/_next/**, /img/**, RSC .txt payloads) untouched, and the empty
             capture at / falls through to the default document. -->
        <rule name="Extensionless route to .html" stopProcessing="true">
          <match url="^(.*)$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{DOCUMENT_ROOT}/{R:1}.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}.html" />
        </rule>
      </rules>
    </rewrite>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <directoryBrowse enabled="false" />

    <staticContent>
      <!-- HTML must not be cached, or a redeploy keeps serving the old page
           and its stale references to content-hashed bundles. The long-lived
           overrides for hashed assets are in the <location> blocks below. -->
      <clientCache cacheControlMode="DisableCache" />

      <!-- Each entry is removed first: IIS returns a 500.19 on a duplicate
           mimeMap, and which of these ship by default varies across IIS
           versions. -->
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".ttf" />
      <mimeMap fileExtension=".ttf" mimeType="font/ttf" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".md" />
      <mimeMap fileExtension=".md" mimeType="text/markdown" />
    </staticContent>

    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering>
        <hiddenSegments>
          <!-- The _next/ tree must stay served — it holds every JS and CSS
               bundle — so it is deliberately absent here. -->
          <add segment="node_modules" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>

  <!-- Filenames under _next/static are content-hashed, so a new deploy always
       produces new URLs. Safe to cache permanently. -->
  <location path="_next/static">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge"
                     cacheControlMaxAge="365.00:00:00"
                     cacheControlCustom="immutable" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- These asset folders are copied verbatim from public/ and are NOT
       content-hashed, so a change reuses the same URL. One week balances
       cache hit rate against how long a stale logo can linger. -->
  <location path="img">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="images">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="fonts">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
