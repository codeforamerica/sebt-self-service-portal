<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" />
    </handlers>
    <httpPlatform processPath="node.exe"
                  arguments="apps\portal\src\SEBT.Portal.Web\server.js"
                  startupTimeLimit="60"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\node-stdout">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="HOSTNAME" value="127.0.0.1" />
        <environmentVariable name="NODE_ENV" value="production" />
        <environmentVariable name="BACKEND_URL" value="http://localhost:5280" />
        <!-- Which state this host serves. Read at request time, so the same package
             can be deployed as any state by changing this value. -->
        <environmentVariable name="STATE" value="dc" />
        <!-- Browser-facing config, read per request by the Next server and served to
             the client. These now take effect here: the values are no longer inlined
             into the client bundle at build time, so the same package can be promoted
             across environments by editing this block on the target host.
             Leave a value empty to keep that integration switched off. -->
        <environmentVariable name="GA_ID" value="" />
        <environmentVariable name="AMPLITUDE_API_KEY" value="" />
        <environmentVariable name="MIXPANEL_TOKEN" value="" />
        <environmentVariable name="SITEIMPROVE_ID" value="" />
        <environmentVariable name="SOCURE_SDK_KEY" value="" />
        <environmentVariable name="SOCURE_DI_SDK_KEY" value="" />
        <environmentVariable name="SMARTY_EMBEDDED_KEY" value="" />
        <environmentVariable name="MOCK_SOCURE" value="false" />
        <!-- Emit OTLP to a collector on localhost:4317, matching the backend.
             Setting the endpoint is what turns the web SDK on. -->
        <environmentVariable name="OTEL_EXPORTER_OTLP_ENDPOINT" value="http://localhost:4317" />
        <environmentVariable name="OTEL_SERVICE_NAME" value="sebt-portal-web" />
        <environmentVariable name="OTEL_DEPLOYMENT_ENVIRONMENT" value="production" />
      </environmentVariables>
    </httpPlatform>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment=".next" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
