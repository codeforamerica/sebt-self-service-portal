{
  "name": "@sebt/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "tokens": "node ../../../../packages/design-system/design/scripts/generate-tokens.js",
    "tokens:sass": "node ../../../../packages/design-system/design/scripts/generate-sass-tokens.js",
    "tokens:fonts": "node ../../../../packages/design-system/design/scripts/generate-fonts.js",
    "tokens:all": "node ../../../../packages/design-system/design/scripts/generate-all-tokens.js",
    "copy:generate": "node ../../../../packages/design-system/content/scripts/generate-locales.js --out-dir content/locales --ts-out src/lib/generated-locale-resources.ts --app portal && node ../../../../packages/design-system/content/scripts/generate-backend-email.js --out-dir ../SEBT.Portal.Infrastructure/Templates/Email",
    "copy:validate": "node ../../../../packages/design-system/content/scripts/generate-locales.js --out-dir content/locales --ts-out src/lib/generated-locale-resources.ts --app portal --validate",
    "postinstall": "sh ../../../../packages/design-system/design/scripts/copy-uswds-assets.sh",
    "predev": "node ../../../../packages/design-system/design/scripts/state-banner.js && pnpm --silent tokens && pnpm --silent tokens:sass && pnpm --silent tokens:fonts && pnpm --silent copy:generate",
    "dev": "next dev --turbopack",
    "prebuild": "node ../../../../packages/design-system/design/scripts/state-banner.js && pnpm --silent tokens && pnpm --silent tokens:sass && pnpm --silent tokens:fonts && pnpm --silent copy:generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "pretest": "pnpm --silent copy:generate",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "pa11y-ci",
    "lighthouse": "lhci autorun",
    "analyze": "ANALYZE=true pnpm build",
    "size": "size-limit",
    "knip": "knip",
    "knip:production": "knip --production"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^2.42.3",
    "@next/third-parties": "^16.2.6",
    "@opentelemetry/api": "^1.9.1",
    "@sebt/analytics": "workspace:*",
    "@sebt/design-system": "workspace:*",
    "@sebt/observability": "workspace:*",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.100.10",
    "@uswds/uswds": "^3.13.0",
    "i18next": "^26.1.0",
    "jose": "^6.2.3",
    "next": "16.2.11",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-i18next": "^17.0.7",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.3",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^16.2.6",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@playwright/test": "^1.60.0",
    "@size-limit/file": "^12.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.6",
    "axe-core": "^4.11.4",
    "babel-plugin-react-compiler": "1.0.0",
    "baseline-browser-mapping": "^2.10.34",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.6",
    "eslint-plugin-security": "^4.0.0",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "pa11y-ci": "^4.1.1",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "puppeteer": "25.1.0",
    "sass": "^1.99.0",
    "sass-embedded": "^1.99.0",
    "sass-loader": "^17.0.0",
    "size-limit": "^12.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.6"
  }
}
