  "_socure_comment": [
    "Socure identity verification integration.",
    "ApiKey: obtain from Socure RiskOS dashboard > Developer Workbench > API Keys (sandbox and production are different).",
    "WebhookSecret: the Bearer token Socure sends in webhook Authorization headers. Set in Socure dashboard under Webhook settings.",
    "Webhook URL allowlist: Socure sandbox only delivers webhooks to URLs that have been pre-registered in the dashboard. For local development, expose the API via ngrok (or equivalent) and register the public URL (e.g. https://<hash>.ngrok.io/api/socure/webhook) in the Socure dashboard under Webhook settings. Without this step the docv status will never transition past 'pending' — the SDK and backend are healthy but terminal verdicts never arrive.",
    "UseStub: set to false to use the real Socure API. When true, uses a local stub that always returns DocumentVerificationRequired.",
    "DocvTransactionTokenTtlMinutes: after this many minutes from issuance, StartChallenge requests a new DocV token via Socure using the stored id-proofing inputs on the challenge (default 20).",
    "DiSessionToken: fallback for when the frontend DI SDK is not integrated. Any value works in sandbox (e.g., 'sandbox-placeholder'). In production, the frontend sends a real token and this fallback is not used.",
    "SandboxPhoneOverride: when set, overrides the user's phone number in Socure requests so DocV SMS links go to your real phone. Format: +1XXXXXXXXXX. Leave null or remove in production."
  ],
  "Socure": {
    "Enabled": true,
    "UseStub": false,
    "ApiKey": "SECRET_STORE_IN_USERSECRETS_OR_AWS_SECRETS_NOT_APP_CONFIG",
    "WebhookSecret": "SECRET_STORE_IN_USERSECRETS_OR_AWS_SECRETS_NOT_APP_CONFIG",
    "BaseUrl": "https://riskos.sandbox.socure.com",
    "ChallengeExpirationMinutes": 30,
    "DocvTransactionTokenTtlMinutes": 20,
    "ApiVersion": "2025-01-01.orion",
    "Workflow": "consumer_onboarding",
    "DocvStepupWorkflow": "docv_stepup",
    "DocvEnrichmentName": "SocureDocRequest",
    "DiSessionToken": "sandbox-placeholder",
    "SandboxPhoneOverride": "+1YOUR_PHONE_NUMBER",
    "DocvEgregiousReasonRejection": {
      "Enabled": true,
      "ReasonCodes": [
        "R815",
        "R819",
        "R820",
        "R827",
        "R834",
        "R836",
        "R845"
      ]
    }
  },
  "PiiEncryption": {
    "EncryptAtRest": true,
    "RunStartupBackfill": true,
    "ActiveKeyId": "local-dev-primary",
    "Keys": [
      {
        "KeyId": "local-dev-primary",
        "KeyMaterialBase64": "YWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWE="
      }
    ]
  },
  "IdProofingRequirements": {
    "household+view": {
      "application": "IAL1",
      "coloadedStreamline": "IAL1",
      "streamline": "IAL1plus"
    }
  },
  "IdProofingEligibility": {
    "RequireQualifyingHouseholdForSocure": true
  },
  "FeatureManagement": {
    "email_dob_opt_in": false,
    "show_application_number": false,
    "show_case_number": false,
    "show_card_last4": false,
    "enable_beta_banner": true,
    "outage_page_enabled": false,
    "enable_checker_maintenance_banner": false,
    // Manual outage toggle for the enrollment checker, for unscheduled emergencies. Only
    // consulted when no OutageSchedule windows target the checker; when such windows exist,
    // the schedule wins and this flag is ignored. Keep false here; flip at runtime via the
    // AWS AppConfig AppSettings profile.
    "checker_outage_page_enabled": false,
    // Off withdraws the checker's income screening tool. Turn on only once the
    // EnrollmentChecker:IncomeEligibility figures below match the current year's
    // federal poverty guidelines.
    "enable_checker_income_eligibility": false,
    // DC Summer EBT applications closed August 23, 2026 (DC-701). Off hides every
    // portal apply CTA/link. DC additionally has no apply destination in code, so
    // flipping this alone does not resurface DC apply UI.
    "enable_apply": false,
    // The 2026 season has ended, so the enrollment checker reports in the past tense
    // and drops every apply path. Turn back on when DC opens the next season's
    // enrollment. Wider than enable_apply, which only covers the application window
    // inside a season.
    "enable_enrollment": false
  },
  "EnrollmentChecker": {
    // 185% of the federal poverty guideline, used by the checker's income screening.
    // Reissued annually — review both figures each year and update via the AWS
    // AppConfig AppSettings profile.
    "IncomeEligibility": {
      "BaseThreshold": 28953,
      "PerMemberIncrement": 10175,
      "MaxHouseholdSize": 8
    }
  },
  // OutageSchedule drives the outage pages when windows are present (inside window = on).
  // Each window's Target says which surface it takes down: "Portal", "EnrollmentChecker",
  // or "Both" (case-insensitive). Omitting Target means "Both" — a backend outage affects
  // every surface unless the window says otherwise. A window whose Target is misspelled is
  // skipped entirely (logged as a warning), so double-check spelling when scheduling.
  // Start/End are local wall-clock times in TimeZoneId (ISO-8601, no offset); start-inclusive,
  // end-exclusive. Windows targeting a surface make the schedule the sole authority for that
  // surface: keep the manual flags (outage_page_enabled, checker_outage_page_enabled) false.
  // Editable at runtime via the AWS AppConfig AppSettings profile (hot-reloads) or by
  // redeploying this file.
  // Validated at startup. An unknown TimeZoneId, an unparseable Start/End, an End that is not
  // after its Start, or a Target other than Portal / EnrollmentChecker / Both (omit for Both)
  // stops the app from starting, and every problem is reported at once. Pushing a malformed
  // schedule to AppConfig on a running server is rejected too: it is logged Critical and the
  // feature-flag endpoints fail until the schedule is corrected.
  "OutageSchedule": {
    "TimeZoneId": "America/New_York",
    "Windows": [
      {
        "Start": "2026-06-15T22:00:00",
        "End": "2026-06-16T06:00:00",
        "Target": "Both"
      }
    ]
  },
  "SelfServiceRules": {
    "AddressUpdate": {
      "Enabled": true,
      "ByIssuanceType": {
        "SummerEbt": { "Enabled": true, "AllowedCardStatuses": [], "AllowedCaseStatuses": ["Approved"] },
        "TanfEbtCard": { "Enabled": false },
        "SnapEbtCard": { "Enabled": false },
        "Unknown": { "Enabled": false }
      }
    },
    "CardReplacement": {
      "Enabled": true,
      "ByIssuanceType": {
        "SummerEbt": { "Enabled": true, "AllowedCardStatuses": [], "AllowedCaseStatuses": ["Approved"] },
        "TanfEbtCard": { "Enabled": false },
        "SnapEbtCard": { "Enabled": false },
        "Unknown": { "Enabled": false }
      }
    }
  }
}
