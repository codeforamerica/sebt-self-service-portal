# Static-export image for the enrollment checker. Not wired to CI — the deploy
# workflow (deploy-enrollment-checker.yaml) builds on the runner and ships to S3;
# keep this for container-based hosting alternatives and local testing.
# ── Stage 1: Build static export ───────────────────────────────────────────
FROM node:24-alpine AS builder
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/ ./packages/
COPY apps/portal/src/SEBT.EnrollmentChecker.Web/ ./apps/portal/src/SEBT.EnrollmentChecker.Web/

RUN corepack enable && pnpm install --frozen-lockfile

# Static export — all env vars baked in at build time
ARG STATE=co
ARG BASE_PATH=''
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_PORTAL_URL
ARG NEXT_PUBLIC_APPLICATION_URL
ARG NEXT_PUBLIC_AMPLITUDE_API_KEY=""
ARG NEXT_PUBLIC_MIXPANEL_TOKEN=""
ARG NEXT_PUBLIC_SITEIMPROVE_ID=""
ENV STATE=$STATE \
    BASE_PATH=$BASE_PATH \
    NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL \
    NEXT_PUBLIC_PORTAL_URL=$NEXT_PUBLIC_PORTAL_URL \
    NEXT_PUBLIC_APPLICATION_URL=$NEXT_PUBLIC_APPLICATION_URL \
    NEXT_PUBLIC_AMPLITUDE_API_KEY=$NEXT_PUBLIC_AMPLITUDE_API_KEY \
    NEXT_PUBLIC_MIXPANEL_TOKEN=$NEXT_PUBLIC_MIXPANEL_TOKEN \
    NEXT_PUBLIC_SITEIMPROVE_ID=$NEXT_PUBLIC_SITEIMPROVE_ID

# API routes are SSR-only proxies — remove them before static export
RUN rm -rf apps/portal/src/SEBT.EnrollmentChecker.Web/src/app/api

RUN BUILD_STATIC=true pnpm --filter @sebt/enrollment-checker build
# Output is in apps/portal/src/SEBT.EnrollmentChecker.Web/out/
# Upload to S3: aws s3 sync apps/portal/src/SEBT.EnrollmentChecker.Web/out/ s3://your-bucket/
# CloudFront: configure error page 404 → /index.html (200 status) for SPA routing
