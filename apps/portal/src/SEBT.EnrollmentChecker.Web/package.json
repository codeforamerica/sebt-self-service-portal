{
  "name": "@sebt/enrollment-checker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "tokens": "node ../../../../packages/design-system/design/scripts/generate-tokens.js",
    "tokens:sass": "node ../../../../packages/design-system/design/scripts/generate-sass-tokens.js",
    "tokens:fonts": "node ../../../../packages/design-system/design/scripts/generate-fonts.js",
    "copy:generate": "node ../../../../packages/design-system/content/scripts/generate-locales.js --out-dir content/locales --ts-out src/lib/generated-locale-resources.ts --app enrollment --sections S1,GLOBAL,S10,S9,DEV,S11",
    "postinstall": "sh ../../../../packages/design-system/design/scripts/copy-uswds-assets.sh",
    "predev": "node ../../../../packages/design-system/design/scripts/state-banner.js && pnpm --silent tokens && pnpm --silent tokens:sass && pnpm --silent tokens:fonts && pnpm --silent copy:generate",
    "dev": "next dev --turbopack",
    "prebuild": "node ../../../../packages/design-system/design/scripts/state-banner.js && pnpm --silent tokens && pnpm --silent tokens:sass && pnpm --silent tokens:fonts && pnpm --silent copy:generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pretypecheck": "pnpm --silent tokens:fonts && pnpm --silent copy:generate",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --silent copy:generate",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "pa11y-ci"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^2.45.10",
    "@sebt/analytics": "workspace:*",
    "@sebt/design-system": "workspace:*",
    "@sebt/observability": "workspace:*",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.103.1",
    "@uswds/uswds": "^3.14.0",
    "i18next": "^26.4.2",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.14",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^25.8.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.6",
    "eslint-plugin-security": "^4.0.1",
    "jsdom": "^30.1.0",
    "msw": "^2.15.0",
    "pa11y-ci": "^4.1.1",
    "prettier": "^3.9.7",
    "prettier-plugin-organize-imports": "^4.3.0",
    "sass": "^1.104.1",
    "sass-embedded": "^1.104.1",
    "sass-loader": "^17.0.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
