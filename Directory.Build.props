<Project>

  <!--
    Repository-wide MSBuild defaults. Applied to every .csproj below this directory
    via MSBuild's automatic import of Directory.Build.props.

    NuGet vulnerability auditing: enabled by default in .NET 8+, but we set it
    explicitly so the policy is discoverable in source rather than relying on
    SDK defaults. Audit results surface as NU190x warnings during `dotnet restore`;
    promoting them to errors causes restore (and therefore build/CI) to fail on
    any known CVE in direct or transitive dependencies.

      NU1901 = low      NU1902 = moderate
      NU1903 = high     NU1904 = critical

    Lockfiles (below) pin the exact versions we restore; NuGetAudit complements
    them by failing the build when a pinned direct or transitive package has a
    known CVE.
  -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <!-- 
    Triggers generation of NuGet package lock files (packages.lock.json) for 
    all projects in the directory or subdirectories.
  -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    Single source of truth for the plugin-contract version
    (SEBT.Portal.StatesPlugins.Interfaces). The contract project derives its
    VersionPrefix from this; consumers' NuGet fallback references float on the
    matching prerelease/stable range. Bump here when the contract version
    changes. The external dc-connector repo cannot see this file and pins its
    own copy — keep them in step (see apps/connectors/dc/README.md).
  -->
  <PropertyGroup>
    <StateConnectorInterfacesVersion>0.0.4</StateConnectorInterfacesVersion>
    <StateConnectorInterfacesFloatingVersion>$(StateConnectorInterfacesVersion)-*</StateConnectorInterfacesFloatingVersion>
  </PropertyGroup>

</Project>
